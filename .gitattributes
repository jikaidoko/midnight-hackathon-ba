# Line-ending normalization. This file MUST exist before the first `git add`:
# if it is added later, already-indexed files keep CRLF and re-copying them is
# not enough - it takes `git add --renormalize .`, because the working file did
# not change and git will not re-index it.
* text=auto eol=lf

*.compact text eol=lf
*.ts      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf

# Compact compiler artifacts. Currently ignored; the rule stands in case a key
# or a zkir is ever versioned.
*.prover   binary
*.verifier binary
*.zkir     binary
*.bzkir    binary
