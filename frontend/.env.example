# Chain mode. Anything other than `chain` runs the mocks, which is the default:
# "some variables are set" is not a statement of intent, and a demo that
# silently falls back to mocks in front of an audience is the failure to avoid.
VITE_MN_MODE=chain

# Fail-closed and value-checked, not just presence-checked. A build configured
# for one network and pointed at another's indexer answers every query happily.
VITE_MN_NETWORK=undeployed

# `v4`, and the version is load-bearing. The indexer answers `/api/v1/...` with
# a 308 redirect, which `fetch` follows and a WebSocket does NOT: a one-shot
# query would work while every subscription died silently, so the live view
# would never emit and nothing would say why.
VITE_MN_INDEXER_URL=http://127.0.0.1:8088/api/v4/graphql
VITE_MN_INDEXER_WS_URL=ws://127.0.0.1:8088/api/v4/graphql/ws
VITE_MN_PROOF_SERVER_URL=http://127.0.0.1:6300

# From the deployment record written by `npm run deploy` (in `contracts/`).
VITE_MN_CONTRACT_ADDRESS=

# `reviewThreshold` is a sealed ledger field: the circuit reads it, no client
# can. It comes from the deployment record.
VITE_MN_REVIEW_THRESHOLD=3

# Encrypts the reporter credential at rest. 16+ chars, 3 of 4 character classes,
# no runs, no sequences - the SDK rejects anything weaker on the first write.
# A build-time constant protects the store from another origin, NOT from whoever
# holds the build. Prompting the reporter is what makes this real.
VITE_MN_PRIVATE_STATE_PASSWORD=
