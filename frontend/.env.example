# Chain mode. Anything other than `chain` runs the mocks, which is the default:
# "some variables are set" is not a statement of intent, and a demo that
# silently falls back to mocks in front of an audience is the failure to avoid.
VITE_MN_MODE=chain

# Fail-closed and value-checked, not just presence-checked. A build configured
# for one network and pointed at another's indexer answers every query happily.
VITE_MN_NETWORK=undeployed

# `v4`, and the version is load-bearing. The indexer answers `/api/v1/...` with
# a 308 redirect, which `fetch` follows and a WebSocket does NOT: a one-shot
# query would work while every subscription died silently, so the live view
# would never emit and nothing would say why.
VITE_MN_INDEXER_URL=http://127.0.0.1:8088/api/v4/graphql
VITE_MN_INDEXER_WS_URL=ws://127.0.0.1:8088/api/v4/graphql/ws
VITE_MN_PROOF_SERVER_URL=http://127.0.0.1:6300

# Substrate node. Only WRITES need it - reads go through the indexer - but it is
# required all the same, because the alternative is a build that looks healthy
# until the first button and then cannot say where it would have sent the
# transaction. Submission converts this to `ws://` itself.
VITE_MN_NODE_URL=http://127.0.0.1:9944

# From the deployment record written by `npm run deploy` (in `contracts/`).
VITE_MN_CONTRACT_ADDRESS=

# `reviewThreshold` is a sealed ledger field: the circuit reads it, no client
# can. It comes from the deployment record.
VITE_MN_REVIEW_THRESHOLD=3

# Encrypts the reporter credential at rest. 16+ chars, 3 of 4 character classes,
# no runs, no sequences - the SDK rejects anything weaker on the first write.
# A build-time constant protects the store from another origin, NOT from whoever
# holds the build. Prompting the reporter is what makes this real.
VITE_MN_PRIVATE_STATE_PASSWORD=

# 🔴 The two values below are 32 bytes written as 64 hex characters, they do
# UNRELATED jobs, and nothing about either says which is which. Swapping them
# does not fail readably: a valid proof of a false statement gets built - tens of
# seconds of real work - and dies inside the circuit. Configuration refuses two
# equal values up front, which is the only cheap check available.

# Funds, balances and signs. Required for every WRITE; reading the ledger needs
# no wallet at all, which is what the oversight view rests on. This is the local
# network's genesis seed - public, unfunded anywhere else, and baked into the
# build, so WHOEVER HOLDS THE BUILD HOLDS THE WALLET. The connector API is what
# replaces it.
VITE_MN_WALLET_SEED=

# Preimage of the contract's published `authorityCommitment`, from the
# deployment record. OPTIONAL, and the option is the design: a reporter's build
# has no business holding it, so its absence is legitimate and fails only when
# someone tries to record an answer, named.
#
# 🔴 Set here, WHOEVER HOLDS THE BUILD IS THE CONTROL BODY. Leave it empty unless
# this build is the portal.
VITE_MN_AUTHORITY_SECRET=
