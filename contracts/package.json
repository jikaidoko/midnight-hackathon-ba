{
  "name": "@amparo/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Amparo - Compact circuits for a private whistleblowing channel (Midnight Hackathon BA).",
  "license": "Apache-2.0",
  "scripts": {
    "compile": "npm run compile:cases && npm run compile:filing",
    "compile:cases": "compact compile src/case_admission.compact src/managed/case_admission",
    "compile:cases:fast": "compact compile --skip-zk src/case_admission.compact src/managed/case_admission",
    "compile:fast": "npm run compile:cases:fast && npm run compile:filing:fast",
    "compile:filing": "compact compile src/filing_registry.compact src/managed/filing_registry",
    "compile:filing:fast": "compact compile --skip-zk src/filing_registry.compact src/managed/filing_registry",
    "test": "tsx --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
