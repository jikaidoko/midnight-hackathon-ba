# Copy to `contracts/.env` and edit. `.env` is gitignored and must stay that way:
# it carries a wallet seed.
#
# Defaults in code already point at the LOCAL network, so for local work you can
# leave every line commented out. You only need a `.env` to reach a public
# network, or to override one value.
#
# Precedence, verified against the loader: variables already present in the shell
# WIN over this file. That is what lets you run a single command against the
# local network without editing a `.env` aimed at a public one:
#
#   MN_NETWORK=undeployed MN_NODE_URL=http://127.0.0.1:9944 npm run check-wallet

# ---------------------------------------------------------------------------
# LOCAL standalone network (docker-compose.midnight.yml) - these are the code
# defaults. Start it with `npm run mn:up`.
# ---------------------------------------------------------------------------
#MN_NETWORK=undeployed
#MN_PROOF_SERVER_URL=http://127.0.0.1:6300
#MN_INDEXER_URL=http://127.0.0.1:8088/api/v4/graphql
#MN_INDEXER_WS_URL=ws://127.0.0.1:8088/api/v4/graphql/ws
#MN_NODE_URL=http://127.0.0.1:9944
# Empty on the local network means "use the pre-funded genesis wallet".
#MN_WALLET_SEED=

# ---------------------------------------------------------------------------
# PUBLIC network. The proof server still runs LOCALLY (proving is client-side by
# design); only the node and the indexer are remote. Start just that one service
# with `npm run proof-server` - not `mn:up`, which would also start a local chain
# and give you a second, conflicting node on the same ports.
#
# The wallet must be funded (test NIGHT and DUST) before anything can be
# submitted. A newly synced wallet has neither.
# ---------------------------------------------------------------------------
#MN_NETWORK=preprod
#MN_PROOF_SERVER_URL=http://127.0.0.1:6300
#MN_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
#MN_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
#MN_NODE_URL=https://rpc.preprod.midnight.network
# Hex seed of a funded wallet. SECRET: never commit it, never paste it into a
# chat, an issue or a pull request.
#MN_WALLET_SEED=

# ---------------------------------------------------------------------------
# Optional tuning. Every one of these has a working default.
# ---------------------------------------------------------------------------

# How often the wallet serializes its sync state to `.wallet-state/`, in ms.
# 0 disables persistence, which means the next start re-scans from genesis.
#MN_WALLET_PERSIST_MS=30000

# Ignore any saved state and re-scan from genesis. On a public network this
# costs hours; use it only when you suspect the saved state is wrong.
#MN_WALLET_COLD_START=false

# Sync backpressure. The in-flight buffer between the websocket feed and the
# apply loop is what makes memory grow during a long historical scan; lowering
# it trades sync speed for a flat memory profile.
#MN_SYNC_BUFFER_SIZE=2000
#MN_SYNC_BATCH_SPACING=8

# Encrypts the local private-state database. Policy: at least 16 characters,
# drawn from at least 3 of uppercase, lowercase, digits, symbols. A password that
# fails the policy is rejected on the first write, in the middle of a deployment.
#MN_PRIVATE_STATE_PASSWORD=

# Override the root of the compiler output (defaults to src/managed). The
# contract is read from the `amparo` subdirectory underneath.
#MN_MANAGED_DIR=

# Label identifying the reporter whose secret the filing scripts use. Reporters
# are kept in separate private-state namespaces, so this is what decides whose
# filings a credential proves. Overridden per command by `-- --subject <label>`.
#MN_SUBJECT=default
