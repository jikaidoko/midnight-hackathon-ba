pragma language_version >= 0.23;
import CompactStandardLibrary;

// ─────────────────────────────────────────────────────────────────────────────
// Amparo — FILING REGISTRY. Steps 1-3 (core + public counter + review flag).
//
// Two outputs from one flow:
//   A. a private, per-subject filing count that backs a threshold credential
//      ("I have filed at least N times") without revealing the count;
//   B. a public per-case counter that flags a case for review once enough
//      independent subjects have reported it.
//
// A filing is only accepted for a case that the oversight authority already
// admitted. That anchor is what makes output B non-spammable: the case seal
// stops being a free witness value and becomes a membership claim against a
// public registry.
//
// ⚠️ INTEGRATION NOTE — read before wiring this to case_admission.compact.
// This contract verifies membership by PURE COMPARISON against a mocked `admittedRoot`
// ledger field, seeded through the constructor so this circuit can be built and
// tested standalone.
//
// That mock MUST NOT survive integration. In case_admission.compact,
// `admittedRoot` is explicitly a display-only mirror: the authority writes it as
// a plain parameter and no circuit can bind it to the real tree, because
// `root()` is runtime-only. Verifying membership against it would let the
// authority declare any root it likes and would destroy the anti-spam guarantee
// this contract exists to provide.
//
// At integration, `admittedRoot` here is replaced by the shared
// `admittedCases: HistoricMerkleTree<20, Bytes<32>>` and the check becomes
// `admittedCases.checkRoot(merkleTreePathRoot(path))`. The historic ADT accepts
// past roots, so in-flight filings are not invalidated by new admissions.
//
// Toolchain: language 0.23. Compiled clean on compactc 0.31.0 (WSL) and
// 0.31.1 (macOS arm64).
// ─────────────────────────────────────────────────────────────────────────────

// ── Public state ─────────────────────────────────────────────────────────────

// MOCK (pre-integration only — see integration note above).
export ledger admittedRoot: MerkleTreeDigest;

// One entry per (subject, case) pair that has already filed. Bound to the PAIR,
// not just the case: it stops a single subject from inflating one case, while
// still letting different subjects report the same case. Queried with an
// already-disclosed nullifier, so the lookup leaks nothing new.
export ledger spentFilingNullifiers: Set<Bytes<32>>;

// The same nullifiers, as a tree. This is what makes the credential sound: a
// Set lookup with a privately-derived key is a disclosure (the compiler says so
// — "ledger operation might disclose a hash of the witness value"), so proving
// "I hold N of these" without naming them needs Merkle paths instead.
// Historic, so a proof built before someone else files is still valid after.
export ledger filingNullifierTree: HistoricMerkleTree<20, Bytes<32>>;

// One entry per (subject, presentation context). Stops a threshold proof from
// being replayed against the same verifier.
export ledger spentPresentationNullifiers: Set<Bytes<32>>;

// Output B: how many distinct subjects have filed against each case. Public on
// purpose — the subject of this count is an admitted site or incident, not a
// person. Privacy points at the reporter; transparency points at the institution.
export ledger caseReports: Map<Bytes<32>, Counter>;

// Cases whose report count reached `reviewThreshold`. This is the flag the
// public view watches flip live: a site moves to "under review" not because
// anyone was identified, but because enough independent reports converged.
export ledger casesUnderReview: Set<Bytes<32>>;

// How many independent reports move a case to review. Sealed: deploy-time
// configuration, never rewritable afterwards, and the compiler enforces it.
sealed ledger reviewThreshold: Uint<64>;

// ── Private inputs ───────────────────────────────────────────────────────────

// The subject's only secret. Runs on their machine, never reaches the chain.
witness subjectSecret(): Bytes<32>;

// ── Constructor ──────────────────────────────────────────────────────────────

// `root` is public configuration of the registry, not a secret: disclosing it
// is intentional.
constructor(root: MerkleTreeDigest, threshold: Uint<64>) {
  admittedRoot = disclose(root);
  reviewThreshold = disclose(threshold);
}

// ── Domain-separated derivations ─────────────────────────────────────────────

// Ties a filing to the (subject, case) pair.
//
// Exported as `pure` so the client can compute the exact same value to mirror
// the nullifier tree. Reimplementing this hash in TypeScript would drift, and
// a drifted mirror produces paths that never verify.
export pure circuit filingNullifierOf(
  secret: Bytes<32>,
  caseCommitment: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "amparo:filing-nullifier:v1"),
    secret,
    caseCommitment
  ]);
}

circuit filingNullifier(caseCommitment: Bytes<32>): Bytes<32> {
  return filingNullifierOf(subjectSecret(), caseCommitment);
}

// Ties a threshold proof to the (subject, verifier context) pair. A separate
// domain prefix keeps it from ever colliding with a filing nullifier.
circuit presentationNullifier(context: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "amparo:presentation-nullifier:v1"),
    subjectSecret(),
    context
  ]);
}

// ── Filing ───────────────────────────────────────────────────────────────────

// Records one filing against an admitted case.
//
// `path` is supplied by the subject as a witness value, so it is untrusted on
// arrival: the circuit re-derives the root from it and compares. A fabricated
// path yields a different root and the assert fires.
export circuit registerFiling(
  caseCommitment: Bytes<32>,
  path: MerkleTreePath<20, Bytes<32>>
): [] {
  assert(path.leaf == caseCommitment, "Path leaf does not match the case");
  assert(merkleTreePathRoot<20, Bytes<32>>(path) == admittedRoot,
    "Case is not in the admitted registry");

  const nullifier = disclose(filingNullifier(caseCommitment));
  assert(!spentFilingNullifiers.member(nullifier), "Subject already filed for this case");
  spentFilingNullifiers.insert(nullifier);
  filingNullifierTree.insert(nullifier);

  // Output B. `Map<K, Counter>` does not auto-initialise: looking up a missing
  // key fails, so the entry has to be created before the first increment.
  const caseKey = disclose(caseCommitment);
  if (!caseReports.member(caseKey)) {
    caseReports.insert(caseKey, default<Counter>);
  }
  caseReports.lookup(caseKey).increment(1);

  // Threshold flag. Written as `>=` on the running count rather than any
  // subtraction: `count - threshold` underflows on Uint before the bar is met.
  // Guarded by `member` so the set stays idempotent past the threshold.
  if (!casesUnderReview.member(caseKey)
      && caseReports.lookup(caseKey).read() >= reviewThreshold) {
    casesUnderReview.insert(caseKey);
  }

}

// ── Threshold credential (output A) ──────────────────────────────────────────

// Proves the caller already has THREE distinct filings recorded on-chain,
// revealing neither which ones nor who they are.
//
// ANCHORED, not self-reported. Each leaf must be a nullifier the caller can
// derive from their own secret, and each path must reach a root of the public
// nullifier tree. Inventing a count buys nothing: you cannot produce a Merkle
// path to a leaf that was never inserted.
//
// Only `claimedRoot` is disclosed, and a tree root is public knowledge already.
// The paths and the case commitments stay private, which is the whole point —
// a Set lookup would have leaked them, since any ledger operation on a
// witness-derived value counts as a disclosure in Compact 0.31.
//
// ⚠️ The verifier MUST check off-chain that `claimedRoot` is a real root of
// `filingNullifierTree`. The circuit cannot do it: `root()` is runtime-only, so
// no circuit can bind a declared root to the tree. Without that check a caller
// could present paths into a tree of their own making. Same guard shape as
// `assertMirrorMatchesTree` in case-registry.ts.
//
// Three is fixed at compile time. Compact loops are compile-time bounded, so
// the arity of the proof is too — a runtime N would not compile.
//
// There is no `false` branch by design: a subject below the bar cannot build a
// passing transaction at all, so no context is consumed by a failed attempt.
export circuit proveRepeatFilings(
  cases: Vector<3, Bytes<32>>,
  paths: Vector<3, MerkleTreePath<20, Bytes<32>>>,
  claimedRoot: MerkleTreeDigest,
  context: Bytes<32>
): Boolean {
  const root = disclose(claimedRoot);

  // Distinct cases, or one filing would be counted three times.
  assert(cases[0] != cases[1], "Cases presented must be distinct");
  assert(cases[0] != cases[2], "Cases presented must be distinct");
  assert(cases[1] != cases[2], "Cases presented must be distinct");

  // Each leaf is a nullifier only this subject can derive, and each path
  // reaches the claimed root.
  assert(paths[0].leaf == filingNullifier(cases[0]), "Leaf is not a nullifier of the caller");
  assert(paths[1].leaf == filingNullifier(cases[1]), "Leaf is not a nullifier of the caller");
  assert(paths[2].leaf == filingNullifier(cases[2]), "Leaf is not a nullifier of the caller");

  assert(merkleTreePathRoot<20, Bytes<32>>(paths[0]) == root, "Filing is not on record");
  assert(merkleTreePathRoot<20, Bytes<32>>(paths[1]) == root, "Filing is not on record");
  assert(merkleTreePathRoot<20, Bytes<32>>(paths[2]) == root, "Filing is not on record");

  // One presentation per (subject, verifier context). Spent only once every
  // check above has passed, so a rejected attempt never burns the context.
  const presentation = disclose(presentationNullifier(context));
  assert(!spentPresentationNullifiers.member(presentation),
    "Threshold proof already presented in this context");
  spentPresentationNullifiers.insert(presentation);

  return true;
}
