# Environment for the standalone indexer of the LOCAL network.
#
# Read by docker-compose.midnight.yml via `env_file`. Every value here is a
# development default for a throwaway local chain. None of it is a secret, and
# none of it may be reused against a public network.

# The indexer reaches the node through the compose service name, not localhost:
# inside the container, localhost is the indexer itself.
APP__INFRA__NODE__URL=ws://node:9944

# Passwords for the indexer's embedded storage and pub/sub. Local-only.
APP__INFRA__STORAGE__PASSWORD=indexer
APP__INFRA__PUB_SUB__PASSWORD=indexer
APP__INFRA__LEDGER_STATE_STORAGE__PASSWORD=indexer

# 32-byte (64 hex) secret for wallet-indexer sessions. Disposable.
APP__INFRA__SECRET=303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f
